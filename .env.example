DATABASE_URL="postgresql://USER@localhost:5432/leafshoes_development?schema=public"
DATABASE_URL_TEST="postgresql://USER@localhost:5432/leafshoes_test?schema=public"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Tài khoản admin seed cho dev (KHÔNG dùng giá trị mặc định này ở production).
SEED_OWNER_EMAIL="change-me"
SEED_OWNER_PASSWORD="change-me"
SEED_STAFF_EMAIL="change-me"
SEED_STAFF_PASSWORD="change-me"

# Upload ảnh sản phẩm (local disk). Mặc định (nếu bỏ trống): <cwd>/uploads.
# UPLOAD_DIR="/absolute/path/to/uploads"
# MAX_UPLOAD_BYTES=5242880

# VietQR — tài khoản ngân hàng NHẬN tiền (điền giá trị THẬT ở .env, KHÔNG commit).
VIETQR_BANK_CODE="MB"
VIETQR_ACCOUNT_NO="0000000000"
VIETQR_ACCOUNT_NAME="LEAFSHOES VIETNAM"
# VIETQR_TEMPLATE="compact2"

# Gửi email xác nhận đơn hàng (Resend) — điền giá trị THẬT ở .env, KHÔNG commit.
# Worker (`npm run worker`) xác thực CẢ RESEND_API_KEY/MAIL_FROM/VIETQR_*/
# APP_BASE_URL lúc khởi động (fail fast) — xem README mục "Job nền (pg-boss)".
RESEND_API_KEY="change-me"
# Domain dự kiến của shop: leafshoesvietnam.com — CHƯA verify ở Resend, nên
# giai đoạn dev dùng sandbox "onboarding@resend.dev" (chỉ giao được tới email
# chủ tài khoản Resend, đặt qua MAIL_TO_OVERRIDE). Verify domain xong thì đổi
# MAIL_FROM thành "no-reply@leafshoesvietnam.com" là gửi được cho mọi khách.
MAIL_FROM="onboarding@resend.dev"
# MAIL_TO_OVERRIDE="email-chu-tai-khoan-resend@example.com"
# Hộp thư của shop nhận reply từ khách (Resend không gửi được từ gmail.com,
# nên set replyTo trỏ về hộp thư này thay vì MAIL_FROM).
# MAIL_REPLY_TO="shop@example.com"

# BẮT BUỘC cho worker (`npm run worker`) — dùng để dựng link "/orders/<mã đơn>"
# trong email xác nhận. KHÔNG có mặc định localhost cho worker: thiếu biến này
# worker từ chối khởi động thay vì gửi email chứa link chết cho khách.
APP_BASE_URL="http://localhost:3000"
